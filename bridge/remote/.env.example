# Disabled unless this explicit flag is present.
REMOTE_MCP_ENABLED=1
NODE_ENV=production
HOST=0.0.0.0
PORT=8787
PUBLIC_BASE_URL=https://context-bridge.example.com
ALLOWED_ORIGINS=https://app.example.com
TRUST_PROXY_HTTPS=1

DATABASE_URL=postgresql://context_bridge:replace-me@db.example.com/context_bridge
DATABASE_SSL=1
REMOTE_ENCRYPTION_KEY_B64=REPLACE_WITH_32_RANDOM_BYTES_BASE64

OIDC_ISSUER=https://identity.example.com/
OIDC_AUDIENCE=https://context-bridge.example.com
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
OIDC_REQUIRED_TYP=at+jwt

# Development only; production refuses this mode.
# NODE_ENV=development
# PUBLIC_BASE_URL=http://127.0.0.1:8787
# ALLOWED_ORIGINS=http://127.0.0.1:4173
# TRUST_PROXY_HTTPS=0
# ALLOW_INSECURE_DEV_AUTH=1
