{
  "name": "context-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "bridge/local",
    "bridge/remote"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test": "npm run test:unit",
    "test:security": "node --import tsx --test tests/security/*.test.ts",
    "test:e2e": "npm run build && node --test tests/e2e/*.test.mjs",
    "benchmark": "node --import tsx benchmarks/run.ts",
    "audit:permissions": "node scripts/audit-permissions.mjs",
    "audit:build": "node scripts/audit-build.mjs",
    "audit:dependencies": "npm audit --audit-level=high",
    "verify": "npm run typecheck && npm run lint && npm test && npm run test:security && npm run benchmark && npm run build && npm run audit:permissions && npm run audit:build && npm run test:e2e && npm run audit:dependencies",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@playwright/test": "1.62.1",
    "@sparticuz/chromium": "149.0.0",
    "@types/chrome": "0.2.5",
    "@types/node": "26.2.0",
    "@types/pg": "8.21.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.11",
    "typescript": "7.0.2"
  }
}
